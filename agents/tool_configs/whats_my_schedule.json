{
  "type": "webhook",
  "name": "whats_my_schedule",
  "description": "Get the caller's current recorded schedule in plain words. Never add dosing advice.",
  "response_timeout_secs": 10,
  "execution_mode": "immediate",
  "api_schema": {
    "url": "https://{{system_env__core_host}}/tools/whats_my_schedule",
    "method": "POST",
    "request_headers": { "X-Village-Secret": { "env_var_label": "core_secret" } },
    "request_body_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conversation_id", "caller_id", "call_secs", "utterance"],
      "properties": {
        "conversation_id": { "type": "string", "dynamic_variable": "system__conversation_id" },
        "caller_id": { "type": "string", "dynamic_variable": "system__caller_id" },
        "call_secs": { "type": "string", "dynamic_variable": "system__call_duration_secs" },
        "utterance": { "type": "string" },
        "tool_call_id": { "type": "string" },
        "village_id": { "type": "string", "dynamic_variable": "village_id" },
        "slot": { "type": "string", "enum": ["morning", "midday", "evening", "bedtime", "all"] },
        "language": { "type": "string", "enum": ["es", "en"] }
      }
    }
  },
  "assignments": [
    { "dynamic_variable": "say_text", "value_path": "say" }
  ]
}

