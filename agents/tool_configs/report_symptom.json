{
  "api_schema": {
    "url": "${TUNNEL_URL}/tools/report_symptom",
    "method": "POST",
    "request_headers": {
      "Content-Type": "application/json",
      "X-Village-Secret": {
        "env_var_label": "VILLAGE_TOOL_SECRET"
      }
    },
    "request_body_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conversation_id",
        "caller_id",
        "call_secs",
        "utterance",
        "description",
        "emergency_signals"
      ],
      "properties": {
        "conversation_id": {
          "type": "string",
          "dynamic_variable": "system__conversation_id"
        },
        "caller_id": {
          "type": "string",
          "dynamic_variable": "system__caller_id"
        },
        "call_secs": {
          "type": "string",
          "dynamic_variable": "system__call_duration_secs"
        },
        "utterance": {
          "type": "string",
          "description": "utterance"
        },
        "tool_call_id": {
          "type": "string",
          "description": "tool call id"
        },
        "village_id": {
          "type": "string",
          "dynamic_variable": "village_id"
        },
        "description": {
          "type": "string",
          "description": "description"
        },
        "type": {
          "type": "string",
          "enum": [
            "symptom",
            "mood",
            "fall",
            "blood_pressure_reading",
            "blood_sugar_reading",
            "info_for_family"
          ],
          "description": "type"
        },
        "value": {
          "type": "string",
          "description": "value"
        },
        "emergency_signals": {
          "type": "boolean",
          "description": "emergency signals"
        }
      },
      "description": "Request body for report_symptom"
    }
  },
  "assignments": [
    {
      "dynamic_variable": "gate_decision",
      "value_path": "decision"
    },
    {
      "dynamic_variable": "say_text",
      "value_path": "say"
    }
  ],
  "description": "Record how the caller feels or other family-relevant information. Do not diagnose.",
  "disable_interruptions": false,
  "dynamic_variables": {
    "dynamic_variable_placeholders": {}
  },
  "force_pre_tool_speech": false,
  "name": "report_symptom",
  "response_timeout_secs": 10,
  "type": "webhook"
}
