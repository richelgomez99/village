{
  "type": "webhook",
  "name": "report_symptom",
  "description": "Record how the caller feels or other family-relevant information. Do not diagnose.",
  "response_timeout_secs": 10,
  "execution_mode": "immediate",
  "api_schema": {
    "url": "https://{{system_env__core_host}}/tools/report_symptom",
    "method": "POST",
    "request_headers": { "X-Village-Secret": { "env_var_label": "core_secret" } },
    "request_body_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conversation_id", "caller_id", "call_secs", "utterance", "description", "emergency_signals"],
      "properties": {
        "conversation_id": { "type": "string", "dynamic_variable": "system__conversation_id" },
        "caller_id": { "type": "string", "dynamic_variable": "system__caller_id" },
        "call_secs": { "type": "string", "dynamic_variable": "system__call_duration_secs" },
        "utterance": { "type": "string" },
        "tool_call_id": { "type": "string" },
        "village_id": { "type": "string", "dynamic_variable": "village_id" },
        "description": { "type": "string" },
        "type": { "type": "string", "enum": ["symptom", "mood", "fall", "blood_pressure_reading", "blood_sugar_reading", "info_for_family"] },
        "value": { "type": "string" },
        "emergency_signals": { "type": "boolean" }
      }
    }
  },
  "assignments": [
    { "dynamic_variable": "gate_decision", "value_path": "decision" },
    { "dynamic_variable": "say_text", "value_path": "say" }
  ]
}

