{
  "api_schema": {
    "url": "${TUNNEL_URL}/tools/get_today",
    "method": "POST",
    "request_headers": {
      "Content-Type": "application/json",
      "X-Village-Secret": {
        "env_var_label": "VILLAGE_TOOL_SECRET"
      }
    },
    "request_body_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conversation_id",
        "caller_id",
        "call_secs",
        "utterance"
      ],
      "properties": {
        "conversation_id": {
          "type": "string",
          "dynamic_variable": "system__conversation_id"
        },
        "caller_id": {
          "type": "string",
          "dynamic_variable": "system__caller_id"
        },
        "call_secs": {
          "type": "string",
          "dynamic_variable": "system__call_duration_secs"
        },
        "utterance": {
          "type": "string",
          "description": "utterance"
        },
        "tool_call_id": {
          "type": "string",
          "description": "tool call id"
        },
        "village_id": {
          "type": "string",
          "dynamic_variable": "village_id"
        },
        "intent": {
          "type": "string",
          "enum": [
            "status",
            "take_another",
            "who_is_coming"
          ],
          "description": "intent"
        }
      },
      "description": "Request body for get_today"
    }
  },
  "assignments": [
    {
      "dynamic_variable": "say_text",
      "value_path": "say"
    }
  ],
  "description": "Get today's status and on-duty person. Always use before questions about taking another pill.",
  "disable_interruptions": false,
  "dynamic_variables": {
    "dynamic_variable_placeholders": {}
  },
  "force_pre_tool_speech": false,
  "name": "get_today",
  "response_timeout_secs": 10,
  "type": "webhook"
}
