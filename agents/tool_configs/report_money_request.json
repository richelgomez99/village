{
  "api_schema": {
    "url": "https://richel-macbook.tail8feae0.ts.net/tools/report_money_request",
    "method": "POST",
    "request_headers": {
      "Content-Type": "application/json",
      "X-Village-Secret": {
        "env_var_label": "VILLAGE_TOOL_SECRET"
      }
    },
    "request_body_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conversation_id",
        "caller_id",
        "call_secs",
        "utterance",
        "urgency"
      ],
      "properties": {
        "conversation_id": {
          "type": "string",
          "dynamic_variable": "system__conversation_id"
        },
        "caller_id": {
          "type": "string",
          "dynamic_variable": "system__caller_id"
        },
        "call_secs": {
          "type": "string",
          "dynamic_variable": "system__call_duration_secs"
        },
        "utterance": {
          "type": "string",
          "description": "utterance"
        },
        "tool_call_id": {
          "type": "string",
          "description": "tool call id"
        },
        "village_id": {
          "type": "string",
          "dynamic_variable": "village_id"
        },
        "claimed_member": {
          "type": "string",
          "description": "claimed member"
        },
        "claimed_identity": {
          "type": "string",
          "description": "claimed identity"
        },
        "amount": {
          "type": "number",
          "description": "amount"
        },
        "currency": {
          "type": "string",
          "description": "currency"
        },
        "method": {
          "type": "string",
          "enum": [
            "gift_card",
            "crypto",
            "wire",
            "payment_app",
            "cash_courier",
            "bank_details",
            "cash",
            "unknown"
          ],
          "description": "method"
        },
        "urgency": {
          "type": "string",
          "enum": [
            "now",
            "today",
            "unspecified"
          ],
          "description": "urgency"
        },
        "red_flags": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "secrecy",
              "urgency",
              "emotional_pressure",
              "jail_bail",
              "hospital",
              "accident",
              "voice_changed",
              "new_number",
              "threat_arrest",
              "safe_account",
              "prize",
              "asks_village_to_pay"
            ],
            "description": "red flags item"
          },
          "description": "red flags"
        }
      },
      "description": "Request body for report_money_request"
    }
  },
  "assignments": [
    {
      "dynamic_variable": "gate_decision",
      "value_path": "decision"
    },
    {
      "dynamic_variable": "say_text",
      "value_path": "say"
    },
    {
      "dynamic_variable": "verification_id",
      "value_path": "data.verification_id"
    },
    {
      "dynamic_variable": "verification_status",
      "value_path": "data.status"
    }
  ],
  "description": "Report that someone asked the caller for money, gift cards, crypto, a transfer, cash pickup, or bank/card/Medicare/SSN details. Call immediately before giving any opinion.",
  "disable_interruptions": true,
  "dynamic_variables": {
    "dynamic_variable_placeholders": {}
  },
  "force_pre_tool_speech": false,
  "name": "report_money_request",
  "response_timeout_secs": 10,
  "type": "webhook"
}
