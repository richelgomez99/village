{
  "api_schema": {
    "url": "${TUNNEL_URL}/hooks/elevenlabs/tools/create_village",
    "method": "POST",
    "request_headers": {
      "Content-Type": "application/json",
      "X-Village-Secret": {
        "env_var_label": "VILLAGE_TOOL_SECRET"
      }
    },
    "request_body_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conversation_id",
        "caller_id",
        "call_secs",
        "utterance",
        "description",
        "members",
        "needs"
      ],
      "properties": {
        "conversation_id": {
          "type": "string",
          "dynamic_variable": "system__conversation_id"
        },
        "caller_id": {
          "type": "string",
          "dynamic_variable": "system__caller_id"
        },
        "call_secs": {
          "type": "string",
          "dynamic_variable": "system__call_duration_secs"
        },
        "utterance": {
          "type": "string",
          "description": "utterance"
        },
        "tool_call_id": {
          "type": "string",
          "description": "tool call id"
        },
        "description": {
          "type": "string",
          "description": "description"
        },
        "members": {
          "type": "array",
          "items": {
            "type": "object",
            "description": "members item"
          },
          "description": "members"
        },
        "needs": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "needs item"
          },
          "description": "needs"
        },
        "medications_mentioned": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "medications mentioned item"
          },
          "description": "medications mentioned"
        },
        "language": {
          "type": "string",
          "description": "language"
        }
      },
      "description": "Request body for create_village"
    }
  },
  "assignments": [
    {
      "dynamic_variable": "village_id",
      "value_path": "data.village_id"
    },
    {
      "dynamic_variable": "next_question",
      "value_path": "data.next_question"
    }
  ],
  "description": "Start the village from the founder's opener (their words verbatim). Returns the village id and the first intake question to ask, word for word.",
  "disable_interruptions": false,
  "dynamic_variables": {
    "dynamic_variable_placeholders": {}
  },
  "force_pre_tool_speech": false,
  "name": "create_village",
  "response_timeout_secs": 20,
  "type": "webhook"
}
