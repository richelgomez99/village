# Village prep: copy to .env and fill in. Never commit .env.
# This file is also `source`d by setup-mac.sh, so keep values shell-safe (no spaces, no quotes needed).
# Check with: uv run smoke/00_env_check.py   (prints which vars are set, never their values)

# --- Daytona (sandboxes, preview URLs, snapshot) --- smoke 02/03/04/08
# app.daytona.io > Dashboard > API Keys (redeem coupon under Billing first)
DAYTONA_API_KEY=
# Optional region for sandboxes/snapshots, e.g. us or eu. Blank = org default. SDK reads it from env.
DAYTONA_TARGET=

# --- Anchor Browser --- smoke 05
# app.anchorbrowser.io > API keys. The SDK reads ANCHORBROWSER_API_KEY (05 also accepts ANCHOR_API_KEY).
ANCHORBROWSER_API_KEY=
# Optional: a Daytona signed preview URL (03 --keep prints one) to test the warning interstitial in a real browser
PREVIEW_URL=

# --- SurrealDB Agent Memory (facts, supersession, uncertainty) --- smoke 06
# studio.surrealdb.com > Agent Memory > your context > API keys view shows the context host + sp-... key
# Base host only, e.g. https://<context-host>  (scripts append /api/v1/{context})
SURREAL_MEMORY_URL=
# Context id used in /api/v1/{context_id}/..., e.g. village-demo
SURREAL_MEMORY_CONTEXT=
# Data-plane key, starts with sp-
SURREAL_MEMORY_API_KEY=

# --- SurrealDB Cloud instance (operational store, LIVE SELECT) --- smoke 06b
# studio.surrealdb.com > Cloud instance > Connect. wss:// endpoint (the SDK appends /rpc).
# Local fallback: surreal start -u root -p root memory  ->  ws://localhost:8000 root/root
SURREAL_DB_URL=
SURREAL_DB_NS=village
SURREAL_DB_DB=main
SURREAL_DB_USER=
SURREAL_DB_PASS=

# --- Arize AX (tracing) --- smoke 07
# app.arize.com > Space settings: Space ID + API key
ARIZE_SPACE_ID=
ARIZE_API_KEY=
ARIZE_PROJECT_NAME=village

# --- AWS Bedrock (Claude via "Claude in Amazon Bedrock" / Mantle) --- smoke 01/07
# Workshop Studio event page > "Get AWS CLI credentials" (temporary, ~1h; re-paste when 01 says expired)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only for temporary credentials (Workshop Studio always gives one)
AWS_SESSION_TOKEN=
# Alternative auth: a Bedrock API key (long-term keys survive session expiry, if organizers allow)
AWS_BEARER_TOKEN_BEDROCK=
# Mantle model ids (no us./global. prefix). 5.5 is access-gated; open fallbacks:
#   anthropic.claude-sonnet-5  /  anthropic.claude-haiku-4-5   (01 tells you which work)
BEDROCK_SONNET_MODEL=anthropic.claude-sonnet-5-5
BEDROCK_HAIKU_MODEL=anthropic.claude-haiku-5-5

# --- Anthropic API (fallback LLM, optional) --- smoke 01/07
# platform.claude.com > API keys
ANTHROPIC_API_KEY=
# Opt-in OpenAI provider per role (default stays Anthropic). Roles: chat (participant), chat.mention (@Village), actors (demo actors' lines).
# OPENAI_API_KEY=
# VILLAGE_LLM_PROVIDER_ACTORS=openai
# VILLAGE_LLM_PROVIDER_CHAT=openai

# --- ElevenLabs (voice agent, TTS, phone) --- smoke 09
# elevenlabs.io > Developers > API keys (needs ConvAI + TTS permissions)
ELEVENLABS_API_KEY=
# Blank on first run: 09 creates a smoke agent. Put the printed id here to update instead of create.
ELEVENLABS_AGENT_ID=
# Optional voice; default George JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_VOICE_ID=
# Agents > Phone numbers after importing the Twilio number (needed for 09 --call)
ELEVENLABS_PHONE_NUMBER_ID=
# Shared secret sent by ElevenLabs server tools as X-Village-Secret.
# Generate locally with: python -c 'import secrets; print(secrets.token_urlsafe(32))'
VILLAGE_TOOL_SECRET=
# Your own phone in E.164, e.g. +15551234567 (09 --call dials it)
TEST_CALL_TO=

# --- Tunnel to the local FastAPI core --- smoke 02/03/09
# Run: uv run smoke/08_tool_server.py   then: cloudflared tunnel --url http://localhost:8787
# Paste the https://<random>.trycloudflare.com URL (changes on every cloudflared restart)
TUNNEL_URL=https://richel-macbook.tail8feae0.ts.net

# Demo clock (D17): Friday Oct 16, Marco on duty; reset_demo.sh warps Core to this time
DEMO_CLOCK=2026-10-16T20:50:00-04:00
ADMIN_KEY=change-me-admin-key

# D30: demo village (any id in data/villages/index.json; v_w147 = the block)
DEMO_VILLAGE_ID=v_reyes
RELEASE_DAYTONA_SNAPSHOT=village-kit   # optional: snapshot name for release sandboxes (else RELEASE_DAYTONA_IMAGE)
