DEFINE TABLE IF NOT EXISTS village SCHEMALESS;
DEFINE TABLE IF NOT EXISTS member SCHEMALESS;
DEFINE TABLE IF NOT EXISTS view SCHEMALESS;
DEFINE TABLE IF NOT EXISTS spec_rev SCHEMALESS;
DEFINE TABLE IF NOT EXISTS event SCHEMALESS;
DEFINE TABLE IF NOT EXISTS decision SCHEMALESS;
DEFINE TABLE IF NOT EXISTS verification SCHEMALESS;
DEFINE TABLE IF NOT EXISTS dose_window SCHEMALESS;
DEFINE TABLE IF NOT EXISTS message SCHEMALESS;
DEFINE TABLE IF NOT EXISTS idem SCHEMALESS;
DEFINE TABLE IF NOT EXISTS slot_token SCHEMALESS;

DEFINE INDEX IF NOT EXISTS event_village_at ON event FIELDS village, at;
DEFINE INDEX IF NOT EXISTS decision_village_at ON decision FIELDS village_id, at;
DEFINE INDEX IF NOT EXISTS message_village_at ON message FIELDS village, at;
