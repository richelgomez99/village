{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://village.contracts/v1/voice_tools.schema.json",
  "title": "Voice tool exchange",
  "description": "ElevenLabs server (webhook) tools → POST /tools/{name} on core. The request body is exactly the tool's request_body_schema (no envelope). Every request carries conversation_id, caller_id, call_secs (system__* dynamic variables) and utterance. Every response is {decision, say, say_key?, rule_id, lang, data?}; the agent speaks `say` verbatim (structured procedure branch on `decision`; ElevenLabs assignments: gate_decision←decision, say_text←say, verification_id←data.verification_id). An instance of the root schema is one request/response exchange. The outbound verification agent's submit_verification_answer goes to POST /verifications/{id}/answer ($defs/verification_answer_request).",
  "x-contract-version": "1.3.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tool",
    "request",
    "response"
  ],
  "properties": {
    "tool": {
      "$ref": "#/$defs/tool_name"
    },
    "at": {
      "$ref": "common.schema.json#/$defs/datetime",
      "description": "Fixture only: server time the request arrived."
    },
    "returned_at": {
      "$ref": "common.schema.json#/$defs/datetime",
      "description": "Fixture only: server time the response was sent (await_verification blocks)."
    },
    "http_status": {
      "enum": [
        200,
        400,
        401,
        409,
        422,
        503
      ]
    },
    "note": {
      "type": "string",
      "maxLength": 300
    },
    "request": {
      "type": "object"
    },
    "response": {
      "$ref": "#/$defs/response"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "tool": {
            "const": "log_dose"
          }
        }
      },
      "then": {
        "properties": {
          "request": {
            "$ref": "#/$defs/req_log_dose"
          },
          "response": {
            "properties": {
              "data": {
                "$ref": "#/$defs/data_log_dose"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "tool": {
            "const": "report_symptom"
          }
        }
      },
      "then": {
        "properties": {
          "request": {
            "$ref": "#/$defs/req_report_symptom"
          },
          "response": {
            "properties": {
              "data": {
                "$ref": "#/$defs/data_report_symptom"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "tool": {
            "const": "whats_my_schedule"
          }
        }
      },
      "then": {
        "properties": {
          "request": {
            "$ref": "#/$defs/req_whats_my_schedule"
          },
          "response": {
            "properties": {
              "data": {
                "$ref": "#/$defs/data_whats_my_schedule"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "tool": {
            "const": "get_today"
          }
        }
      },
      "then": {
        "properties": {
          "request": {
            "$ref": "#/$defs/req_get_today"
          },
          "response": {
            "properties": {
              "data": {
                "$ref": "#/$defs/data_get_today"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "tool": {
            "const": "ask_family"
          }
        }
      },
      "then": {
        "properties": {
          "request": {
            "$ref": "#/$defs/req_ask_family"
          },
          "response": {
            "properties": {
              "data": {
                "$ref": "#/$defs/data_ask_family"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "tool": {
            "const": "report_money_request"
          }
        }
      },
      "then": {
        "properties": {
          "request": {
            "$ref": "#/$defs/req_report_money_request"
          },
          "response": {
            "required": [
              "data"
            ],
            "properties": {
              "data": {
                "$ref": "#/$defs/data_report_money_request"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "tool": {
            "const": "await_verification"
          }
        }
      },
      "then": {
        "properties": {
          "request": {
            "$ref": "#/$defs/req_await_verification"
          },
          "response": {
            "required": [
              "data"
            ],
            "properties": {
              "data": {
                "$ref": "#/$defs/data_await_verification"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "tool": {
            "const": "create_village"
          }
        }
      },
      "then": {
        "properties": {
          "request": {
            "$ref": "#/$defs/req_create_village"
          },
          "response": {
            "properties": {
              "data": {
                "$ref": "#/$defs/data_create_village"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "tool": {
            "const": "answer_proposal"
          }
        }
      },
      "then": {
        "properties": {
          "request": {
            "$ref": "#/$defs/req_answer_proposal"
          },
          "response": {
            "required": [
              "data"
            ],
            "properties": {
              "data": {
                "$ref": "#/$defs/data_answer_proposal"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "tool": {
            "enum": [
              "report_need",
              "offer_resource",
              "check_rumor",
              "check_in_ok"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "request": {
            "$ref": "#/$defs/req_block"
          }
        }
      }
    }
  ],
  "$defs": {
    "tool_name": {
      "enum": [
        "log_dose",
        "report_symptom",
        "whats_my_schedule",
        "get_today",
        "ask_family",
        "report_money_request",
        "await_verification",
        "create_village",
        "report_need",
        "offer_resource",
        "check_rumor",
        "check_in_ok",
        "answer_proposal"
      ],
      "description": "Care: first 7. Setup agent: create_village. Block line (backup village only): report_need … check_in_ok. answer_proposal (1.1.0, optional; village-caller / coordinator calls, ships only with EVOLVE_VOICE=1): approve or reject an Evolve proposal by voice; gated by R-SPEC (coordinator only)."
    },
    "call_secs": {
      "description": "system__call_duration_secs. ElevenLabs sends dynamic variables as strings; core coerces.",
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?$"
        }
      ]
    },
    "common_fields": {
      "conversation_id": {
        "$ref": "common.schema.json#/$defs/conversation_id"
      },
      "caller_id": {
        "type": "string",
        "pattern": "^(\\+[1-9][0-9]{6,14}|web:[A-Za-z0-9_-]{1,64}|)$",
        "description": "system__caller_id (E.164); empty on web calls; 'web:<session>' when core injects it."
      },
      "call_secs": {
        "$ref": "#/$defs/call_secs"
      },
      "utterance": {
        "type": "string",
        "maxLength": 1000,
        "description": "Caller's exact last words, original language; account/card digits replaced by '#'. May be '' for await_verification."
      },
      "tool_call_id": {
        "type": "string",
        "maxLength": 128,
        "description": "Optional. Idempotency key part; if absent core keys on (conversation_id, tool, call_secs)."
      },
      "village_id": {
        "$ref": "common.schema.json#/$defs/village_id",
        "description": "Optional dynamic variable from the init webhook; core falls back to caller_id lookup."
      }
    },
    "req_log_dose": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conversation_id",
        "caller_id",
        "call_secs",
        "utterance",
        "confidence"
      ],
      "properties": {
        "conversation_id": {
          "$ref": "#/$defs/common_fields/conversation_id"
        },
        "caller_id": {
          "$ref": "#/$defs/common_fields/caller_id"
        },
        "call_secs": {
          "$ref": "#/$defs/common_fields/call_secs"
        },
        "utterance": {
          "$ref": "#/$defs/common_fields/utterance"
        },
        "tool_call_id": {
          "$ref": "#/$defs/common_fields/tool_call_id"
        },
        "village_id": {
          "$ref": "#/$defs/common_fields/village_id"
        },
        "slot": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/slot"
            },
            {
              "const": "current"
            }
          ]
        },
        "pill_description": {
          "type": "string",
          "maxLength": 120,
          "description": "As she said it, e.g. 'la azul'. Core maps lid color → slot."
        },
        "taken_at": {
          "$ref": "common.schema.json#/$defs/datetime"
        },
        "confidence": {
          "enum": [
            "confirmed_by_caller",
            "uncertain"
          ]
        },
        "possible_duplicate": {
          "type": "boolean",
          "description": "She says she already took this slot twice (P-DD-02)."
        },
        "lang": {
          "type": "string",
          "enum": [
            "es",
            "en"
          ],
          "description": "1.3.1: caller's language; the response say is in this language, with both in data.say_es/say_en."
        }
      },
      "anyOf": [
        {
          "required": [
            "slot"
          ]
        },
        {
          "required": [
            "pill_description"
          ]
        }
      ]
    },
    "req_report_symptom": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conversation_id",
        "caller_id",
        "call_secs",
        "utterance",
        "description",
        "emergency_signals"
      ],
      "properties": {
        "conversation_id": {
          "$ref": "#/$defs/common_fields/conversation_id"
        },
        "caller_id": {
          "$ref": "#/$defs/common_fields/caller_id"
        },
        "call_secs": {
          "$ref": "#/$defs/common_fields/call_secs"
        },
        "utterance": {
          "$ref": "#/$defs/common_fields/utterance"
        },
        "tool_call_id": {
          "$ref": "#/$defs/common_fields/tool_call_id"
        },
        "village_id": {
          "$ref": "#/$defs/common_fields/village_id"
        },
        "description": {
          "type": "string",
          "maxLength": 300
        },
        "type": {
          "enum": [
            "symptom",
            "mood",
            "fall",
            "blood_pressure_reading",
            "blood_sugar_reading",
            "info_for_family"
          ]
        },
        "value": {
          "type": "string",
          "maxLength": 40
        },
        "emergency_signals": {
          "type": "boolean"
        },
        "lang": {
          "type": "string",
          "enum": [
            "es",
            "en"
          ],
          "description": "1.3.1: caller's language; the response say is in this language, with both in data.say_es/say_en."
        }
      }
    },
    "req_whats_my_schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conversation_id",
        "caller_id",
        "call_secs",
        "utterance"
      ],
      "properties": {
        "conversation_id": {
          "$ref": "#/$defs/common_fields/conversation_id"
        },
        "caller_id": {
          "$ref": "#/$defs/common_fields/caller_id"
        },
        "call_secs": {
          "$ref": "#/$defs/common_fields/call_secs"
        },
        "utterance": {
          "$ref": "#/$defs/common_fields/utterance"
        },
        "tool_call_id": {
          "$ref": "#/$defs/common_fields/tool_call_id"
        },
        "village_id": {
          "$ref": "#/$defs/common_fields/village_id"
        },
        "slot": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/slot"
            },
            {
              "const": "all"
            }
          ]
        },
        "language": {
          "enum": [
            "es",
            "en"
          ]
        },
        "lang": {
          "type": "string",
          "enum": [
            "es",
            "en"
          ],
          "description": "1.3.1: caller's language; the response say is in this language, with both in data.say_es/say_en."
        }
      }
    },
    "req_get_today": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conversation_id",
        "caller_id",
        "call_secs",
        "utterance"
      ],
      "properties": {
        "conversation_id": {
          "$ref": "#/$defs/common_fields/conversation_id"
        },
        "caller_id": {
          "$ref": "#/$defs/common_fields/caller_id"
        },
        "call_secs": {
          "$ref": "#/$defs/common_fields/call_secs"
        },
        "utterance": {
          "$ref": "#/$defs/common_fields/utterance"
        },
        "tool_call_id": {
          "$ref": "#/$defs/common_fields/tool_call_id"
        },
        "village_id": {
          "$ref": "#/$defs/common_fields/village_id"
        },
        "intent": {
          "enum": [
            "status",
            "take_another",
            "who_is_coming"
          ]
        },
        "lang": {
          "type": "string",
          "enum": [
            "es",
            "en"
          ],
          "description": "1.3.1: caller's language; the response say is in this language, with both in data.say_es/say_en."
        }
      }
    },
    "req_ask_family_fields": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "to",
        "message",
        "urgency"
      ],
      "properties": {
        "to": {
          "type": "string",
          "pattern": "^(on_duty|backup|all|coordinator|[a-z][a-z_]{1,30})$",
          "description": "on_duty | backup | all | coordinator | a member name key (marco) or member id (m_marco)."
        },
        "message": {
          "type": "string",
          "maxLength": 500
        },
        "urgency": {
          "$ref": "common.schema.json#/$defs/family_urgency"
        },
        "reason": {
          "enum": [
            "dose_uncertain",
            "possible_double_dose",
            "missed_dose",
            "symptom",
            "emergency",
            "refill",
            "question",
            "wants_to_talk",
            "money_request"
          ]
        },
        "lang": {
          "type": "string",
          "enum": [
            "es",
            "en"
          ],
          "description": "1.3.1: caller's language; the response say is in this language, with both in data.say_es/say_en."
        }
      }
    },
    "req_ask_family": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conversation_id",
        "caller_id",
        "call_secs",
        "utterance",
        "to",
        "message",
        "urgency"
      ],
      "properties": {
        "conversation_id": {
          "$ref": "#/$defs/common_fields/conversation_id"
        },
        "caller_id": {
          "$ref": "#/$defs/common_fields/caller_id"
        },
        "call_secs": {
          "$ref": "#/$defs/common_fields/call_secs"
        },
        "utterance": {
          "$ref": "#/$defs/common_fields/utterance"
        },
        "tool_call_id": {
          "$ref": "#/$defs/common_fields/tool_call_id"
        },
        "village_id": {
          "$ref": "#/$defs/common_fields/village_id"
        },
        "to": {
          "$ref": "#/$defs/req_ask_family_fields/properties/to"
        },
        "message": {
          "$ref": "#/$defs/req_ask_family_fields/properties/message"
        },
        "urgency": {
          "$ref": "#/$defs/req_ask_family_fields/properties/urgency"
        },
        "reason": {
          "$ref": "#/$defs/req_ask_family_fields/properties/reason"
        },
        "lang": {
          "type": "string",
          "enum": [
            "es",
            "en"
          ],
          "description": "1.3.1: caller's language; the response say is in this language, with both in data.say_es/say_en."
        }
      }
    },
    "req_report_money_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conversation_id",
        "caller_id",
        "call_secs",
        "utterance",
        "urgency"
      ],
      "properties": {
        "conversation_id": {
          "$ref": "#/$defs/common_fields/conversation_id"
        },
        "caller_id": {
          "$ref": "#/$defs/common_fields/caller_id"
        },
        "call_secs": {
          "$ref": "#/$defs/common_fields/call_secs"
        },
        "utterance": {
          "$ref": "#/$defs/common_fields/utterance"
        },
        "tool_call_id": {
          "$ref": "#/$defs/common_fields/tool_call_id"
        },
        "village_id": {
          "$ref": "#/$defs/common_fields/village_id"
        },
        "claimed_member": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,40}$",
          "description": "Name key (marco) or member id (m_marco) of the family member the requester claimed to be or speak for. Omit for anyone else. Core resolves it against the village (unknown → R-MONEY-UNKNOWN)."
        },
        "claimed_identity": {
          "type": "string",
          "maxLength": 120,
          "description": "Who the requester said they were, in her words."
        },
        "amount": {
          "type": "number",
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$",
          "default": "USD"
        },
        "method": {
          "$ref": "common.schema.json#/$defs/money_method"
        },
        "urgency": {
          "$ref": "common.schema.json#/$defs/money_urgency"
        },
        "red_flags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/money_red_flag"
          }
        },
        "lang": {
          "type": "string",
          "enum": [
            "es",
            "en"
          ],
          "description": "1.3.1: caller's language; the response say is in this language, with both in data.say_es/say_en."
        }
      }
    },
    "req_await_verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conversation_id",
        "caller_id",
        "call_secs",
        "utterance",
        "verification_id"
      ],
      "properties": {
        "conversation_id": {
          "$ref": "#/$defs/common_fields/conversation_id"
        },
        "caller_id": {
          "$ref": "#/$defs/common_fields/caller_id"
        },
        "call_secs": {
          "$ref": "#/$defs/common_fields/call_secs"
        },
        "utterance": {
          "$ref": "#/$defs/common_fields/utterance"
        },
        "tool_call_id": {
          "$ref": "#/$defs/common_fields/tool_call_id"
        },
        "village_id": {
          "$ref": "#/$defs/common_fields/village_id"
        },
        "verification_id": {
          "$ref": "common.schema.json#/$defs/verification_id"
        },
        "lang": {
          "type": "string",
          "enum": [
            "es",
            "en"
          ],
          "description": "1.3.1: caller's language; the response say is in this language, with both in data.say_es/say_en."
        }
      }
    },
    "req_create_village": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conversation_id",
        "caller_id",
        "call_secs",
        "utterance",
        "description",
        "members",
        "needs"
      ],
      "properties": {
        "conversation_id": {
          "$ref": "#/$defs/common_fields/conversation_id"
        },
        "caller_id": {
          "$ref": "#/$defs/common_fields/caller_id"
        },
        "call_secs": {
          "$ref": "#/$defs/common_fields/call_secs"
        },
        "utterance": {
          "$ref": "#/$defs/common_fields/utterance"
        },
        "tool_call_id": {
          "$ref": "#/$defs/common_fields/tool_call_id"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "description": "Coordinator's own words, verbatim."
        },
        "members": {
          "type": "array",
          "minItems": 1,
          "maxItems": 24,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "relationship",
              "channel"
            ],
            "properties": {
              "name": {
                "type": "string",
                "maxLength": 80
              },
              "relationship": {
                "type": "string",
                "maxLength": 80
              },
              "role_hint": {
                "enum": [
                  "coordinator",
                  "care_recipient",
                  "caregiver",
                  "resident",
                  "volunteer",
                  "peer",
                  "unknown"
                ]
              },
              "channel": {
                "enum": [
                  "app",
                  "voice",
                  "sms",
                  "unknown"
                ]
              },
              "language": {
                "$ref": "common.schema.json#/$defs/lang"
              },
              "availability": {
                "type": "string",
                "maxLength": 120
              }
            }
          }
        },
        "needs": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 200
          }
        },
        "medications_mentioned": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 80
          }
        },
        "language": {
          "$ref": "common.schema.json#/$defs/lang"
        },
        "lang": {
          "type": "string",
          "enum": [
            "es",
            "en"
          ],
          "description": "1.3.1: caller's language; the response say is in this language, with both in data.say_es/say_en."
        }
      }
    },
    "req_answer_proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "conversation_id",
        "caller_id",
        "call_secs",
        "utterance",
        "proposal_id",
        "answer"
      ],
      "description": "1.1.0, optional. HTTP twin of the WS/app actions approve_proposal / reject_proposal for the voice path. Core resolves caller_id → member; only the coordinator may answer (R-SPEC), anyone else gets decision deny.",
      "properties": {
        "conversation_id": {
          "$ref": "#/$defs/common_fields/conversation_id"
        },
        "caller_id": {
          "$ref": "#/$defs/common_fields/caller_id"
        },
        "call_secs": {
          "$ref": "#/$defs/common_fields/call_secs"
        },
        "utterance": {
          "$ref": "#/$defs/common_fields/utterance"
        },
