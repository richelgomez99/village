    "data_report_money_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "verification_id",
        "claimed_member_id",
        "channels",
        "deadline",
        "next"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "unverifiable",
            "denied_request"
          ],
          "description": "pending = verification open · unverifiable = R-MONEY-UNKNOWN or unreachable · denied_request = R-MONEY-NEVER."
        },
        "verification_id": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/verification_id"
            },
            {
              "type": "null"
            }
          ]
        },
        "claimed_member_id": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/member_id"
            },
            {
              "type": "null"
            }
          ]
        },
        "channels": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/verification_channel"
          }
        },
        "deadline": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/datetime"
            },
            {
              "type": "null"
            }
          ]
        },
        "deadline_secs": {
          "type": "integer",
          "minimum": 0
        },
        "incident_id": {
          "$ref": "common.schema.json#/$defs/incident_id"
        },
        "next": {
          "enum": [
            "await_verification",
            "none"
          ],
          "description": "await_verification only when status = pending."
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "pending"
              }
            }
          },
          "then": {
            "properties": {
              "verification_id": {
                "type": "string"
              },
              "next": {
                "const": "await_verification"
              }
            }
          },
          "else": {
            "properties": {
              "next": {
                "const": "none"
              }
            }
          }
        }
      ]
    },
