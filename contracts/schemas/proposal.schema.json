{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://village.contracts/v1/proposal.schema.json",
  "title": "Evolve proposal",
  "description": "A proposed spec change from Evolve (D13: detect → investigate → fix → verify → human approves). Produced by evals (detector + evidence) and builder (patch_app ops), verified by release, approved by the coordinator (R-SPEC), applied by core as WS `patch` messages per role. Status flow: proposed → verifying → ready → approved → applied; or rejected / failed. 1.1.0: approve (POST /villages/{id}/proposals/{pid}/approve, WS/app action approve_proposal, voice tool answer_proposal) is allowed on `proposed` (starts verification and auto-applies on ready) as well as `ready`; 409 for verifying | approved | applied | rejected | failed. Reject (…/reject, action reject_proposal) is allowed on proposed | verifying | ready and records rejected_by / rejected_at.",
  "x-contract-version": "1.3.4",
  "$ref": "#/$defs/proposal",

  "$defs": {
    "status": { "enum": ["proposed", "verifying", "ready", "approved", "applied", "rejected", "failed"] },
    "evidence": {
      "type": "object", "additionalProperties": false, "required": ["kind", "ref", "label"],
      "properties": {
        "kind": { "enum": ["trace", "fact", "call_moment"] },
        "ref": { "type": "string", "maxLength": 200, "description": "trace: Arize trace id · fact: Agent Memory fact id/key · call_moment: '<conversation_id>@<secs>'." },
        "label": { "type": "string", "maxLength": 160, "description": "Shown on the card, e.g. 'Oct 9 · call at 0:21 · \"Marco\" asked for $1,500 in gift cards'." },
        "at": { "$ref": "common.schema.json#/$defs/datetime" },
        "url": { "$ref": "common.schema.json#/$defs/url" },
        "quote": { "type": "string", "maxLength": 300 },
        "eval": { "type": "object", "additionalProperties": false, "required": ["name", "label"], "properties": { "name": { "type": "string" }, "label": { "type": "string" }, "score": { "type": "number" } } }
      },
      "allOf": [
        { "if": { "properties": { "kind": { "const": "trace" } } }, "then": { "properties": { "ref": { "$ref": "common.schema.json#/$defs/trace_id" } } } },
        { "if": { "properties": { "kind": { "const": "call_moment" } } }, "then": { "properties": { "ref": { "pattern": "^[A-Za-z0-9_-]{3,128}@[0-9]+(\\.[0-9]+)?$" } } } }
      ]
    },
    "proposal": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "village", "detected_by", "title", "rationale", "evidence", "ops", "status", "base_rev", "created_at"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/proposal_id" },
        "village": { "$ref": "common.schema.json#/$defs/village_id" },
        "detected_by": { "enum": ["arize_eval", "memory_pattern", "chat_request"] },
        "title": { "$ref": "common.schema.json#/$defs/localized" },
        "rationale": { "$ref": "common.schema.json#/$defs/localized", "description": "builder patch_app 'reason' (coordinator's language) + translations." },
        "changes": { "type": "array", "maxItems": 6, "items": { "$ref": "common.schema.json#/$defs/localized" }, "description": "Bullet lines for the card ('+ ¿Es de verdad? for Mamá')." },
        "evidence": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "$ref": "#/$defs/evidence" } },
        "ops": {
          "type": "object", "minProperties": 1,
          "description": "role_key → RFC 6902 ops against views[role] (builder patch_app rules: add/remove/replace under /elements; ≤12 per role; applied in order).",
          "propertyNames": { "$ref": "common.schema.json#/$defs/role_key" },
          "additionalProperties": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "$ref": "common.schema.json#/$defs/view_patch_op" } }
        },
        "needs_served": {
          "type": "object", "description": "role_key → (element id → need ids) for elements the ops add.",
          "propertyNames": { "$ref": "common.schema.json#/$defs/role_key" },
          "additionalProperties": { "type": "object", "propertyNames": { "$ref": "common.schema.json#/$defs/element_id" }, "additionalProperties": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/need_id" } } }
        },
        "spec_ops": {
          "type": "array", "maxItems": 12,
          "description": "Ops against the whole VillageSpec outside views (printables only in v1).",
          "items": { "allOf": [ { "$ref": "common.schema.json#/$defs/json_patch_op" }, { "properties": { "op": { "enum": ["add", "remove", "replace"] }, "path": { "pattern": "^/printables/" } } } ] }
        },
        "status": { "$ref": "#/$defs/status" },
        "base_rev": { "$ref": "common.schema.json#/$defs/rev" },
        "target_rev": { "$ref": "common.schema.json#/$defs/rev" },
        "release_id": { "$ref": "common.schema.json#/$defs/release_id" },
        "approved_by": { "$ref": "common.schema.json#/$defs/member_id" },
        "approved_at": { "$ref": "common.schema.json#/$defs/datetime" },
        "rejected_by": { "$ref": "common.schema.json#/$defs/member_id", "description": "1.1.0." },
        "rejected_at": { "$ref": "common.schema.json#/$defs/datetime", "description": "1.1.0." },
        "message_id": { "$ref": "common.schema.json#/$defs/message_id", "description": "1.1.0 (D16): the chat post (kind proposal) that carries Approve / Not now." },
        "trace_id": { "$ref": "common.schema.json#/$defs/trace_id" },
        "created_at": { "$ref": "common.schema.json#/$defs/datetime" }
      },
      "allOf": [
        { "if": { "properties": { "status": { "enum": ["verifying", "ready", "approved", "applied"] } } }, "then": { "required": ["release_id", "target_rev"] } },
        { "if": { "properties": { "status": { "enum": ["approved", "applied"] } } }, "then": { "required": ["approved_by", "approved_at"] } },
        { "if": { "properties": { "status": { "const": "rejected" } } }, "then": { "required": ["rejected_by", "rejected_at"] } }
      ]
    }
  },

  "examples": [
    {
      "id": "prop_reyes_scamcheck", "village": "v_reyes", "detected_by": "arize_eval",
      "title": { "en": "Scam check for Mamá", "es": "Revisión de estafas para Mamá" },
      "rationale": { "en": "Two calls asked Mamá for money in Marco's name. A big '¿Es de verdad?' button lets her start a check herself, and the family sees every attempt.", "es": "Dos llamadas le pidieron dinero a Mamá en nombre de Marco. Un botón grande '¿Es de verdad?' le deja empezar una revisión ella misma, y la familia ve cada intento." },
      "changes": [ { "en": "+ “¿Es de verdad?” button for Mamá" }, { "en": "+ Scam alerts for the family" }, { "en": "+ New fridge card: family word first" } ],
      "evidence": [
        { "kind": "call_moment", "ref": "conv_seed_1009@21", "label": "Oct 9 · call at 0:21 · “Marco” asked for $1,500 in gift cards", "at": "2026-10-09T19:21:30-04:00", "quote": "Marco me llamó, dice que necesita tarjetas de regalo." },
        { "kind": "call_moment", "ref": "conv_demo_1016_scam@9", "label": "Today · call at 0:09 · “Marco” asked for $2,000; real Marco: “That wasn't me”", "at": "2026-10-16T14:02:09-04:00", "quote": "Me llamó Marco llorando, dice que está en problemas y necesita dos mil dólares." },
        { "kind": "trace", "ref": "4bf92f3577b34da6a3ce929d0e0e4736", "label": "Arize session eval possible_fraud on both sessions", "eval": { "name": "session_possible_fraud", "label": "possible_fraud", "score": 1 } },
        { "kind": "fact", "ref": "fact:money_request:m_carmen:2026-10-16", "label": "SurrealDB fact: money_request claimed_member=m_marco (src=call:conv_demo_1016_scam, secs=9)" }
      ],
      "ops": {
        "elder": [
          { "op": "add", "path": "/elements/scam", "value": { "type": "ScamCheck", "props": { "label": "¿Es de verdad?", "choices_member_ids": ["m_marco", "m_ana"], "other_label": "Otra persona", "bind": "verifications:mine", "speak": "Vamos a confirmar.", "big": true } } },
          { "op": "add", "path": "/elements/s/children/3", "value": "scam" }
        ],
        "helper": [
          { "op": "add", "path": "/elements/scam", "value": { "type": "IncidentCard", "props": { "title": "Scam alerts", "bind": "incidents:subject=m_carmen", "subject": "m_carmen", "show_red_flags": true, "show_verification": true, "show_provenance": true, "allow_ack": true, "limit": 5 } } },
          { "op": "add", "path": "/elements/s/children/1", "value": "scam" }
        ]
      },
      "needs_served": { "elder": { "scam": ["n_scam_calls"] }, "helper": { "scam": ["n_scam_calls"] } },
      "spec_ops": [ { "op": "replace", "path": "/printables/2/family_word_first", "value": true } ],
      "status": "ready", "base_rev": 4, "target_rev": 5, "release_id": "rel_reyes_r5",
      "created_at": "2026-10-16T14:05:00-04:00"
    }
  ]
}
