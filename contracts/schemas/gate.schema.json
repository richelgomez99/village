{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://village.contracts/v1/gate.schema.json",
  "title": "Gate case (GateInput → Decision)",
  "description": "The deterministic policy gate: decide(input: GateInput) -> Decision, pure (no network, no LLM, no Agent Memory, no clock reads: 'now' is in the input; ids are pre-minted by core in input.alloc). An instance of this root schema is one test case. Lanes use $defs/gate_input and $defs/decision.",
  "x-contract-version": "1.2.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["input", "decision"],
  "properties": {
    "name": { "type": "string", "maxLength": 120, "description": "Test id, e.g. T29 (data/datasets/policy_cases.md)." },
    "input": { "$ref": "#/$defs/gate_input" },
    "decision": { "$ref": "#/$defs/decision" }
  },

  "$defs": {
    "gate_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["village_state", "event", "alloc"],
      "properties": {
        "village_state": { "$ref": "#/$defs/village_state" },
        "event": { "$ref": "#/$defs/candidate" },
        "alloc": {
          "type": "object", "additionalProperties": false, "required": ["decision_id"],
          "description": "Ids core mints before calling the gate, so decide() stays pure. The gate uses them only if it creates that object.",
          "properties": {
            "decision_id": { "$ref": "common.schema.json#/$defs/decision_id" },
            "verification_id": { "$ref": "common.schema.json#/$defs/verification_id" },
            "incident_id": { "$ref": "common.schema.json#/$defs/incident_id" }
          }
        },
        "idempotency_key": { "type": "string", "maxLength": 300, "description": "'<conversation_id>:<tool_call_id>' or '<member_id>:<req_id>'. Core returns the cached Decision for a repeat key without calling decide()." }
      }
    },

    "village_state": {
      "type": "object",
      "description": "Summary core loads from SurrealDB (operational store only) before each decide().",
      "additionalProperties": false,
      "required": ["village_id", "now", "timezone", "kill_switch", "coordinator_id", "rota_today", "members", "dose_windows", "open_verifications", "recent_money_requests"],
      "properties": {
        "village_id": { "$ref": "common.schema.json#/$defs/village_id" },
        "now": { "$ref": "common.schema.json#/$defs/datetime", "description": "Clock.now() including time-warp." },
        "timezone": { "type": "string" },
        "kill_switch": { "type": "boolean", "description": "R-KILL: log only." },
        "village_status": { "$ref": "common.schema.json#/$defs/village_status", "description": "Optional (1.1.0, default active). R-CONSENT / R-VERIFY-CONSENT deny outbound calls and prompts while draft." },
        "coordinator_id": { "$ref": "common.schema.json#/$defs/member_id" },
        "care_recipient_id": { "$ref": "common.schema.json#/$defs/member_id" },
        "quiet_hours": { "$ref": "common.schema.json#/$defs/time_window" },
        "double_dose_window_hours": { "type": "number", "minimum": 0, "default": 6 },
        "rota_today": {
          "type": "object", "additionalProperties": false, "required": ["date", "on_duty", "backup"],
          "properties": { "date": { "$ref": "common.schema.json#/$defs/date" }, "on_duty": { "$ref": "common.schema.json#/$defs/member_id" }, "backup": { "$ref": "common.schema.json#/$defs/member_id" } }
        },
        "members": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "name", "role", "pronoun", "has_app_session", "consent"],
            "properties": {
              "id": { "$ref": "common.schema.json#/$defs/member_id" },
              "name": { "type": "string", "description": "Name used in say templates, e.g. Marco." },
              "aliases": { "type": "array", "items": { "type": "string" }, "description": "Lowercase names the voice agent may send as claimed_member (marco, mijo…)." },
              "role": { "enum": ["coordinator", "care_recipient", "caregiver", "professional_caregiver", "resident", "volunteer", "business", "peer"] },
              "pronoun": { "enum": ["he", "she", "they"], "description": "Selects él/ella in money_confirmed." },
              "has_app_session": { "type": "boolean", "description": "A live or recent (24 h) app session exists (R-VERIFY-CONSENT)." },
              "consent": {
                "type": "object", "additionalProperties": false, "required": ["ai_calls", "app_prompts"],
                "properties": {
                  "ai_calls": { "type": "boolean" }, "app_prompts": { "type": "boolean" }, "dose_logging": { "type": "boolean" }, "money_verifier": { "type": "boolean" },
                  "share_with": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/member_id" } },
                  "money_safety_share_with": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/member_id" } }
                }
              }
            }
          }
        },
        "dose_windows": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["subject", "slot", "date", "slot_time", "state", "version"],
            "properties": {
              "subject": { "$ref": "common.schema.json#/$defs/member_id" },
              "slot": { "$ref": "common.schema.json#/$defs/slot" },
              "date": { "$ref": "common.schema.json#/$defs/date" },
              "slot_time": { "$ref": "common.schema.json#/$defs/hhmm" },
              "state": { "enum": ["scheduled", "window_open", "reminded", "escalated_1", "escalated_2", "taken", "skipped_ack", "closed"] },
              "dose_event_id": { "$ref": "common.schema.json#/$defs/event_id" },
              "taken_at": { "$ref": "common.schema.json#/$defs/datetime" },
              "confidence": { "enum": ["confirmed", "uncertain"] },
              "version": { "type": "integer", "minimum": 0, "description": "CAS version." }
            }
          }
        },
        "active_meds": {
          "type": "array", "description": "Records valid at now (P-MA-02). Used only for whats_my_schedule read-back.",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["med_id", "name", "dose", "slots", "valid_from"],
            "properties": { "med_id": { "type": "string" }, "name": { "type": "string" }, "dose": { "type": "string" }, "slots": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/slot" } }, "valid_from": { "$ref": "common.schema.json#/$defs/date" } }
          }
        },
        "open_verifications": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["id", "claimed_member_id", "state", "deadline", "version"],
            "properties": {
              "id": { "$ref": "common.schema.json#/$defs/verification_id" },
              "claimed_member_id": { "$ref": "common.schema.json#/$defs/member_id" },
              "conversation_id": { "$ref": "common.schema.json#/$defs/conversation_id" },
              "state": { "$ref": "verification.schema.json#/$defs/state" },
              "deadline": { "$ref": "common.schema.json#/$defs/datetime" },
              "version": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "recent_money_requests": {
          "type": "array", "description": "money_request rows for the care recipient in the last 30 days (R-MONEY-PATTERN).",
          "items": { "type": "object", "additionalProperties": false, "required": ["event_id", "at"], "properties": { "event_id": { "$ref": "common.schema.json#/$defs/event_id" }, "at": { "$ref": "common.schema.json#/$defs/datetime" } } }
        }
      }
    },

    "candidate_kind": {
      "anyOf": [
        { "$ref": "event.schema.json#/$defs/kind" },
        { "enum": ["tick", "dose_question", "schedule_query", "ask_family", "call_member", "outbound_call", "verification_answer", "await_returned", "start_verification", "money_transfer_request", "spec_patch", "model_output"] }
      ],
      "description": "Ledger kinds (the gate decides whether/how they are written) plus gate-only intents that are never persisted as-is."
    },
    "candidate": {
      "type": "object",
      "description": "What happened, before the gate. Same envelope as a ledger row minus id. For ledger kinds the payload is the ledger payload with ids not yet known set to null (e.g. money_request.verification_id = null).",
      "additionalProperties": false,
      "required": ["village", "kind", "payload", "actor", "source", "at"],
      "properties": {
        "village": { "$ref": "common.schema.json#/$defs/village_id" },
        "kind": { "$ref": "#/$defs/candidate_kind" },
        "payload": { "type": "object" },
        "actor": { "$ref": "common.schema.json#/$defs/actor" },
        "source": { "$ref": "common.schema.json#/$defs/source" },
        "at": { "$ref": "common.schema.json#/$defs/datetime" }
      },
      "allOf": [
        { "$ref": "event.schema.json#/$defs/payload_by_kind" },
        { "if": { "required": ["kind"], "properties": { "kind": { "const": "tick" } } }, "then": { "properties": { "payload": { "type": "object", "additionalProperties": false, "properties": { "reason": { "enum": ["dose_window", "verification_deadline", "escalation_backup"] } } } } } },
        { "if": { "required": ["kind"], "properties": { "kind": { "const": "dose_question" } } }, "then": { "properties": { "payload": { "type": "object", "additionalProperties": false, "required": ["subject", "intent", "utterance"], "properties": { "subject": { "$ref": "common.schema.json#/$defs/member_id" }, "intent": { "enum": ["status", "take_another", "change_dose", "skip", "double_already_taken"] }, "slot": { "$ref": "common.schema.json#/$defs/slot" }, "utterance": { "type": "string" } } } } } },
        { "if": { "required": ["kind"], "properties": { "kind": { "const": "schedule_query" } } }, "then": { "properties": { "payload": { "type": "object", "additionalProperties": false, "required": ["subject"], "properties": { "subject": { "$ref": "common.schema.json#/$defs/member_id" }, "slot": { "type": "string" } } } } } },
        { "if": { "required": ["kind"], "properties": { "kind": { "const": "ask_family" } } }, "then": { "properties": { "payload": { "$ref": "voice_tools.schema.json#/$defs/req_ask_family_fields" } } } },
        { "if": { "required": ["kind"], "properties": { "kind": { "const": "call_member" } } }, "then": { "properties": { "payload": { "type": "object", "additionalProperties": false, "required": ["target"], "properties": { "target": { "$ref": "common.schema.json#/$defs/member_id" } } } } } },
        { "if": { "required": ["kind"], "properties": { "kind": { "const": "outbound_call" } } }, "then": { "properties": { "payload": { "type": "object", "additionalProperties": false, "required": ["member_id", "reason"], "properties": { "member_id": { "$ref": "common.schema.json#/$defs/member_id" }, "reason": { "enum": ["verification", "escalation", "reminder"] }, "verification_id": { "$ref": "common.schema.json#/$defs/verification_id" }, "event_id": { "$ref": "common.schema.json#/$defs/event_id" } } } } } },
        { "if": { "required": ["kind"], "properties": { "kind": { "const": "verification_answer" } } }, "then": { "properties": { "payload": { "type": "object", "additionalProperties": false, "required": ["verification_id", "answer", "via", "member_id"], "properties": { "verification_id": { "$ref": "common.schema.json#/$defs/verification_id" }, "answer": { "$ref": "common.schema.json#/$defs/verification_answer" }, "via": { "$ref": "common.schema.json#/$defs/verification_channel" }, "member_id": { "$ref": "common.schema.json#/$defs/member_id" }, "quote": { "type": "string" }, "call_sid": { "type": "string" } } } } } },
        { "if": { "required": ["kind"], "properties": { "kind": { "const": "await_returned" } } }, "then": { "properties": { "payload": { "type": "object", "additionalProperties": false, "required": ["verification_id"], "properties": { "verification_id": { "$ref": "common.schema.json#/$defs/verification_id" } } } } } },
        { "if": { "required": ["kind"], "properties": { "kind": { "const": "start_verification" } } }, "then": { "properties": { "payload": { "type": "object", "additionalProperties": false, "required": ["subject", "choice"], "properties": { "subject": { "$ref": "common.schema.json#/$defs/member_id" }, "choice": { "anyOf": [ { "$ref": "common.schema.json#/$defs/member_id" }, { "const": "other" } ] } } } } } },
        { "if": { "required": ["kind"], "properties": { "kind": { "const": "money_transfer_request" } } }, "then": { "properties": { "payload": { "type": "object", "additionalProperties": false, "required": ["utterance"], "properties": { "utterance": { "type": "string" }, "caller_known": { "type": "boolean" } } } } } },
        { "if": { "required": ["kind"], "properties": { "kind": { "const": "spec_patch" } } }, "then": { "properties": { "payload": { "type": "object", "additionalProperties": false, "required": ["proposal_id", "approver"], "properties": { "proposal_id": { "$ref": "common.schema.json#/$defs/proposal_id" }, "approver": { "$ref": "common.schema.json#/$defs/member_id" } } } } } },
        { "if": { "required": ["kind"], "properties": { "kind": { "const": "model_output" } } }, "then": { "properties": { "payload": { "type": "object", "additionalProperties": false, "required": ["text", "channel"], "properties": { "text": { "type": "string" }, "channel": { "enum": ["voice", "app", "builder"] } } } } } }
      ]
    },

    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "rule_id", "decision", "say", "notify", "writes", "rules_fired"],
      "properties": {
        "id": { "$ref": "common.schema.json#/$defs/decision_id" },
        "rule_id": { "$ref": "common.schema.json#/$defs/rule_id", "description": "The deciding rule. R-NOOP for allow with nothing to do." },
        "decision": { "$ref": "common.schema.json#/$defs/gate_decision" },
        "say": { "$ref": "common.schema.json#/$defs/say" },
        "say_key": { "$ref": "common.schema.json#/$defs/say_key" },
        "say_vars": { "type": "object", "additionalProperties": { "type": "string" }, "description": "Values substituted into the template (claimed_name, logged_time, on_duty_name)." },
        "escalate": {
          "type": "object", "additionalProperties": false, "required": ["member_id", "channel"],
          "properties": { "member_id": { "$ref": "common.schema.json#/$defs/member_id" }, "channel": { "enum": ["outbound_call", "app_banner", "both"] }, "level": { "type": "integer", "minimum": 1, "maximum": 3 }, "related_event_id": { "$ref": "common.schema.json#/$defs/event_id", "description": "Optional (1.1.0): the pure gate cannot know the id of a row it is asking core to write; core fills it on the escalation row from writes[]." } }
        },
        "notify": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false, "required": ["member_id", "channel"],
            "properties": { "member_id": { "$ref": "common.schema.json#/$defs/member_id" }, "channel": { "$ref": "common.schema.json#/$defs/notify_channel" }, "severity": { "enum": ["info", "warn", "high"] }, "reason": { "type": "string", "maxLength": 80 } }
          }
        },
        "verification": {
          "type": "object", "additionalProperties": false, "required": ["id", "claimed_member", "deadline", "channels", "state"],
          "description": "Present when the decision opens (or reads) a verification.",
          "properties": {
            "id": { "$ref": "common.schema.json#/$defs/verification_id" },
            "claimed_member": { "$ref": "common.schema.json#/$defs/member_id" },
            "deadline": { "$ref": "common.schema.json#/$defs/datetime" },
            "channels": { "type": "array", "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/verification_channel" } },
            "state": { "$ref": "verification.schema.json#/$defs/state" }
          }
        },
        "writes": { "type": "array", "description": "Ledger rows core must write (in order) with envelope village/actor/source from the input, at = input now.", "items": { "$ref": "event.schema.json#/$defs/event_draft" } },
        "flags": { "type": "array", "uniqueItems": true, "items": { "enum": ["off_schedule", "possible_double_dose", "attempted_duplicate", "possible_fraud_pattern", "red_flag_notify_early", "output_blocked", "kill_switch"] } },
        "rules_fired": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/rule_id" }, "description": "Every rule that matched, deciding rule first (GUARDRAIL span attribute)." }
      },
      "allOf": [
        { "if": { "properties": { "decision": { "const": "verify_with_member" } } }, "then": { "required": ["verification"] } },
        { "if": { "properties": { "decision": { "const": "report_already_logged" } } }, "then": { "required": ["escalate", "say_key"] } }
      ]
    }
  },

  "examples": [
    {
      "name": "T29 money request in Marco's name (headline)",
      "input": {
        "village_state": {
          "village_id": "v_reyes", "now": "2026-10-16T14:02:09-04:00", "timezone": "America/New_York", "kill_switch": false,
          "coordinator_id": "m_ana", "care_recipient_id": "m_carmen", "quiet_hours": "22:30-07:00",
          "rota_today": { "date": "2026-10-16", "on_duty": "m_ana", "backup": "m_lucia" },
          "members": [
            { "id": "m_carmen", "name": "Carmen", "role": "care_recipient", "pronoun": "she", "has_app_session": false, "consent": { "ai_calls": true, "app_prompts": false, "dose_logging": true, "share_with": ["m_ana", "m_marco", "m_lucia"], "money_safety_share_with": ["m_ana", "m_marco"] } },
            { "id": "m_ana", "name": "Ana", "role": "coordinator", "pronoun": "she", "has_app_session": true, "consent": { "ai_calls": true, "app_prompts": true, "money_verifier": true } },
            { "id": "m_marco", "name": "Marco", "aliases": ["marco"], "role": "caregiver", "pronoun": "he", "has_app_session": true, "consent": { "ai_calls": true, "app_prompts": true, "money_verifier": true } },
            { "id": "m_lucia", "name": "Lucía", "aliases": ["lucia"], "role": "caregiver", "pronoun": "she", "has_app_session": true, "consent": { "ai_calls": false, "app_prompts": true, "money_verifier": false } }
          ],
          "dose_windows": [],
          "open_verifications": [],
          "recent_money_requests": [ { "event_id": "ev_1009_1921_money", "at": "2026-10-09T19:21:30-04:00" } ]
        },
        "event": {
          "village": "v_reyes", "kind": "money_request",
          "payload": { "subject": "m_carmen", "claimed_member_id": "m_marco", "claimed_identity": "Marco (her son)", "amount": 2000, "currency": "USD", "method": "unknown", "urgency": "now", "red_flags": ["urgency", "emotional_pressure"], "utterance": "Me llamó Marco llorando, dice que está en problemas y necesita dos mil dólares.", "verification_id": null },
          "actor": "m_carmen", "source": { "kind": "call", "ref": "conv_demo_1016_scam", "secs": 9 }, "at": "2026-10-16T14:02:09-04:00"
        },
        "alloc": { "decision_id": "dc_1016_1402_money", "verification_id": "ver_1016_01", "incident_id": "inc_ver_1016_01" },
        "idempotency_key": "conv_demo_1016_scam:toolu_01"
      },
      "decision": {
        "id": "dc_1016_1402_money", "rule_id": "R-MONEY-VERIFY", "decision": "verify_with_member",
        "say": { "es": "Voy a confirmar con Marco ahora mismo. No mande dinero todavía.", "en": "I'm checking with Marco right now. Please don't send any money yet." },
        "say_key": "money_hold", "say_vars": { "claimed_name": "Marco" },
        "notify": [ { "member_id": "m_ana", "channel": "app", "severity": "warn", "reason": "money_request_pending" } ],
        "verification": { "id": "ver_1016_01", "claimed_member": "m_marco", "deadline": "2026-10-16T14:02:54-04:00", "channels": ["app_prompt", "outbound_call"], "state": "pending" },
        "writes": [
          { "kind": "money_request", "payload": { "subject": "m_carmen", "claimed_member_id": "m_marco", "claimed_identity": "Marco (her son)", "amount": 2000, "currency": "USD", "method": "unknown", "urgency": "now", "red_flags": ["urgency", "emotional_pressure"], "utterance": "Me llamó Marco llorando, dice que está en problemas y necesita dos mil dólares.", "verification_id": "ver_1016_01", "pattern_flag": "possible_fraud_pattern" } },
          { "kind": "verification_pending", "payload": { "verification_id": "ver_1016_01", "subject": "m_carmen", "claimed_member_id": "m_marco", "deadline": "2026-10-16T14:02:54-04:00", "channels": ["app_prompt", "outbound_call"], "origin": "report_money_request" } },
          { "kind": "pattern", "payload": { "subject": "m_carmen", "pattern": "possible_fraud_pattern", "count": 2, "window_days": 30, "event_ids": ["ev_1009_1921_money", "ev_1016_1402_money"] } }
        ],
        "flags": ["possible_fraud_pattern", "red_flag_notify_early"],
        "rules_fired": ["R-MONEY-VERIFY", "R-VERIFY-CONSENT", "R-MONEY-PATTERN"]
      }
    },
    {
      "name": "T28 second lid scan (report-only)",
      "input": {
        "village_state": {
          "village_id": "v_reyes", "now": "2026-10-15T08:40:00-04:00", "timezone": "America/New_York", "kill_switch": false,
          "coordinator_id": "m_ana", "care_recipient_id": "m_carmen",
          "rota_today": { "date": "2026-10-15", "on_duty": "m_marco", "backup": "m_ana" },
          "members": [ { "id": "m_marco", "name": "Marco", "role": "caregiver", "pronoun": "he", "has_app_session": true, "consent": { "ai_calls": true, "app_prompts": true } } ],
          "dose_windows": [ { "subject": "m_carmen", "slot": "morning", "date": "2026-10-15", "slot_time": "08:00", "state": "taken", "dose_event_id": "ev_1015_0802_dose_morning", "taken_at": "2026-10-15T08:02:10-04:00", "confidence": "confirmed", "version": 3 } ],
          "open_verifications": [], "recent_money_requests": []
        },
        "event": {
          "village": "v_reyes", "kind": "dose",
          "payload": { "subject": "m_carmen", "slot": "morning", "taken_at": "2026-10-15T08:40:00-04:00", "confidence": "confirmed", "via": "lid_qr" },
          "actor": "m_carmen", "source": { "kind": "scan", "ref": "st_reyes_morning" }, "at": "2026-10-15T08:40:00-04:00"
        },
        "alloc": { "decision_id": "dc_1015_0840_scan" }
      },
      "decision": {
        "id": "dc_1015_0840_scan", "rule_id": "R-DOUBLE", "decision": "report_already_logged",
        "say": { "es": "Esta tapa ya se anotó a las 8:02. Le avisamos a Marco.", "en": "This lid was already logged at 8:02. We're letting Marco know." },
        "say_key": "dd_report", "say_vars": { "logged_time": "8:02", "on_duty_name": "Marco" },
        "escalate": { "member_id": "m_marco", "channel": "both", "level": 1 },
        "notify": [],
        "writes": [
          { "kind": "dose_repeat_scan", "payload": { "subject": "m_carmen", "slot": "morning", "first_event_id": "ev_1015_0802_dose_morning", "first_taken_at": "2026-10-15T08:02:10-04:00", "attempted_at": "2026-10-15T08:40:00-04:00", "notified": "m_marco" } },
          { "kind": "escalation", "payload": { "to": "m_marco", "channel": "both", "reason": "double_dose_attempt", "rule_id": "R-DOUBLE", "level": 1, "status": "placed" } }
        ],
