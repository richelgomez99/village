{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://village.contracts/v1/ws_messages.schema.json",
  "title": "WebSocket messages",
  "description": "The ONE realtime protocol (D4): GET /ws?village=<id>&m=<member_token>, one socket per client, JSON text frames, one message per frame, discriminated by `type`. Client → server: hello (first frame, required), ack, action, ping. Server → client: snapshot (always first reply to hello and after any rev gap), patch, event, control (Control Room only), prompt, result, pong, error. Reconnect with backoff 0.5 s → 8 s and send hello with last_rev; server answers with a fresh snapshot. Clients apply patch only if patch.base_rev == local rev, otherwise send hello again.",
  "x-contract-version": "1.1.0",
  "oneOf": [ { "$ref": "#/$defs/client_message" }, { "$ref": "#/$defs/server_message" } ],

  "$defs": {
    "client_message": {
      "oneOf": [ { "$ref": "#/$defs/hello" }, { "$ref": "#/$defs/ack" }, { "$ref": "#/$defs/action" }, { "$ref": "#/$defs/ping" } ]
    },
    "server_message": {
      "oneOf": [ { "$ref": "#/$defs/snapshot" }, { "$ref": "#/$defs/patch" }, { "$ref": "#/$defs/event" }, { "$ref": "#/$defs/control" }, { "$ref": "#/$defs/prompt" }, { "$ref": "#/$defs/result" }, { "$ref": "#/$defs/pong" }, { "$ref": "#/$defs/error" }, { "$ref": "#/$defs/chat" } ]
    },

    "hello": {
      "type": "object", "additionalProperties": false, "required": ["type", "contract_version", "village", "member_token"],
      "properties": {
        "type": { "const": "hello" },
        "contract_version": { "$ref": "common.schema.json#/$defs/contract_version" },
        "village": { "$ref": "common.schema.json#/$defs/village_id" },
        "member_token": { "type": "string", "minLength": 16, "maxLength": 2048, "description": "Member token from POST /auth/redeem or the QR (?m=), or the control token for the Control Room." },
        "last_rev": { "$ref": "common.schema.json#/$defs/rev" },
        "client": { "enum": ["kit", "control", "scan_page", "test"] }
      }
    },
    "ack": {
      "type": "object", "additionalProperties": false, "required": ["type", "event_id", "status"],
      "description": "Acknowledge an escalation / incident / banner ('I've got it'). Core writes an ack ledger row.",
      "properties": {
        "type": { "const": "ack" },
        "event_id": { "$ref": "common.schema.json#/$defs/event_id" },
        "status": { "enum": ["got_it", "accepted", "declined", "not_needed"] },
        "req_id": { "$ref": "#/$defs/req_id" }
      }
    },
    "req_id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{4,64}$" },
    "action": {
      "type": "object", "additionalProperties": false, "required": ["type", "req_id", "name"],
      "description": "Same semantics as POST /v/{id}/actions/{name}. Always gated; the server replies with result{req_id}.",
      "properties": {
        "type": { "const": "action" },
        "req_id": { "$ref": "#/$defs/req_id" },
        "name": { "$ref": "common.schema.json#/$defs/action_name" },
        "arg": { "type": "string", "maxLength": 80, "description": "BigButton action_arg (slot:current, m_ana, …)." },
        "element_id": { "$ref": "common.schema.json#/$defs/element_id" },
        "payload": { "$ref": "common.schema.json#/$defs/props" },
        "client_ts": { "$ref": "common.schema.json#/$defs/datetime" }
      },
      "allOf": [
        { "if": { "properties": { "name": { "const": "answer_verification" } } }, "then": { "required": ["payload"], "properties": { "payload": { "type": "object", "required": ["verification_id", "answer"], "properties": { "verification_id": { "$ref": "common.schema.json#/$defs/verification_id" }, "answer": { "$ref": "common.schema.json#/$defs/verification_answer" } } } } } },
        { "if": { "properties": { "name": { "const": "start_verification" } } }, "then": { "required": ["arg"], "properties": { "arg": { "pattern": "^([a-z]_[a-z0-9_]{1,40}|other)$" } } } },
        { "if": { "properties": { "name": { "enum": ["approve_proposal", "reject_proposal"] } } }, "then": { "required": ["arg"], "properties": { "arg": { "$ref": "common.schema.json#/$defs/proposal_id" } } } },
        { "if": { "properties": { "name": { "const": "ack_incident" } } }, "then": { "required": ["arg"], "properties": { "arg": { "$ref": "common.schema.json#/$defs/incident_id" } } } }
      ]
    },
    "ping": { "type": "object", "additionalProperties": false, "required": ["type", "ts"], "properties": { "type": { "const": "ping" }, "ts": { "type": "number" } } },

    "snapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "contract_version", "rev", "village", "role", "member_id", "spec", "data", "now"],
      "properties": {
        "type": { "const": "snapshot" },
        "contract_version": { "$ref": "common.schema.json#/$defs/contract_version" },
        "rev": { "$ref": "common.schema.json#/$defs/rev" },
        "village": { "$ref": "common.schema.json#/$defs/village_id" },
        "role": { "anyOf": [ { "$ref": "common.schema.json#/$defs/role_key" }, { "const": "control" } ] },
        "member_id": { "anyOf": [ { "$ref": "common.schema.json#/$defs/member_id" }, { "type": "null" } ] },
        "spec": { "description": "Member clients: views[role] only. Control Room: the whole VillageSpec." },
        "data": { "$ref": "#/$defs/data" },
        "now": { "$ref": "common.schema.json#/$defs/datetime", "description": "Server clock incl. time-warp; clients render countdowns against it." }
      },
      "allOf": [
        { "if": { "properties": { "role": { "const": "control" } } }, "then": { "properties": { "spec": { "$ref": "village_spec.schema.json" }, "member_id": { "type": "null" } } }, "else": { "properties": { "spec": { "$ref": "village_spec.schema.json#/$defs/view" }, "member_id": { "type": "string" } } } }
      ]
    },
    "data": {
      "type": "object",
      "description": "Resolved bindings keyed by the exact bind string used in the view (e.g. 'alerts:active', 'rota:current?member=me'). Value shapes below (patternProperties); keys with ?count carry a number; null clears a key.",
      "propertyNames": { "type": "string", "maxLength": 200 },
      "patternProperties": {
        "\\?count$": { "type": ["number", "null"] },
        "^alerts:active$": { "anyOf": [ { "type": "array", "items": { "$ref": "#/$defs/bv_alert" } }, { "type": "null" } ] },
        "^verifications:pending\\?member=me$": { "anyOf": [ { "$ref": "#/$defs/bv_pending_prompt" }, { "type": "null" } ] },
        "^verifications:mine$": { "anyOf": [ { "$ref": "#/$defs/bv_my_verification" }, { "type": "null" } ] },
        "^incidents:(open|all|subject=[a-z]_[a-z0-9_]+)$": { "anyOf": [ { "type": "array", "items": { "$ref": "#/$defs/bv_incident" } }, { "type": "null" } ] },
        "^facts:dose_event\\?": { "anyOf": [ { "$ref": "#/$defs/bv_dose_day" }, { "$ref": "#/$defs/bv_dose_week" }, { "type": "null" } ] },
        "^rota:current\\?member=me$": { "anyOf": [ { "$ref": "#/$defs/bv_rota_me" }, { "type": "null" } ] },
        "^rota:current\\.(on_duty|backup)$": { "anyOf": [ { "$ref": "#/$defs/bv_person" }, { "type": "null" } ] },
        "^rota:(current|week)$": { "anyOf": [ { "type": "array", "items": { "$ref": "#/$defs/bv_rota_day" } }, { "type": "null" } ] },
        "^timeline:": { "anyOf": [ { "type": "array", "items": { "$ref": "#/$defs/bv_timeline_item" } }, { "type": "null" } ] },
        "^blueprint:life_areas$": { "anyOf": [ { "type": "array", "items": { "$ref": "#/$defs/bv_life_area" } }, { "type": "null" } ] },
        "^proposals:pending$": { "anyOf": [ { "type": "array", "items": { "$ref": "#/$defs/bv_proposal" } }, { "type": "null" } ] },
        "^chat:village$": { "anyOf": [ { "type": "array", "maxItems": 50, "items": { "$ref": "#/$defs/bv_message" } }, { "type": "null" } ], "description": "1.1.0 (D16): the last 50 chat rows, oldest first. Never sent to elder views." }
      }
    },
    "bv_message": { "$ref": "message.schema.json", "description": "A village chat row (message.schema.json) as bound to chat:village and carried by chat frames." },
    "bv_person": { "type": "object", "additionalProperties": false, "required": ["member_id", "name"], "properties": { "member_id": { "$ref": "common.schema.json#/$defs/member_id" }, "name": { "type": "string" }, "phone": { "$ref": "common.schema.json#/$defs/e164" } } },
    "bv_alert": {
      "type": "object", "additionalProperties": false, "required": ["id", "severity", "title", "body", "at"],
      "properties": {
        "id": { "type": "string" }, "severity": { "enum": ["danger", "warn", "info"] },
        "title": { "$ref": "common.schema.json#/$defs/localized" }, "body": { "$ref": "common.schema.json#/$defs/localized" },
        "event_id": { "$ref": "common.schema.json#/$defs/event_id" },
        "verification": { "type": "object", "additionalProperties": false, "required": ["id", "claimed_member_id", "deadline", "status"], "properties": { "id": { "$ref": "common.schema.json#/$defs/verification_id" }, "claimed_member_id": { "$ref": "common.schema.json#/$defs/member_id" }, "deadline": { "$ref": "common.schema.json#/$defs/datetime" }, "status": { "$ref": "verification.schema.json#/$defs/status" } } },
        "escalation": { "type": "object", "additionalProperties": false, "required": ["to", "channel", "status"], "properties": { "to": { "$ref": "common.schema.json#/$defs/member_id" }, "channel": { "enum": ["outbound_call", "app_banner", "both"] }, "status": { "type": "string" } } },
        "at": { "$ref": "common.schema.json#/$defs/datetime" }
      }
    },
    "bv_pending_prompt": {
      "type": "object", "additionalProperties": false, "required": ["verification_id", "question", "detail", "deadline", "subject"],
      "properties": { "verification_id": { "$ref": "common.schema.json#/$defs/verification_id" }, "question": { "$ref": "common.schema.json#/$defs/localized" }, "detail": { "$ref": "common.schema.json#/$defs/localized" }, "deadline": { "$ref": "common.schema.json#/$defs/datetime" }, "subject": { "$ref": "common.schema.json#/$defs/member_id" } }
    },
    "bv_my_verification": {
      "type": "object", "additionalProperties": false, "required": ["verification_id", "claimed_member_id", "claimed_name", "status", "state", "deadline", "say"],
      "properties": { "verification_id": { "$ref": "common.schema.json#/$defs/verification_id" }, "claimed_member_id": { "$ref": "common.schema.json#/$defs/member_id" }, "claimed_name": { "type": "string" }, "status": { "$ref": "verification.schema.json#/$defs/status" }, "state": { "$ref": "verification.schema.json#/$defs/state" }, "deadline": { "$ref": "common.schema.json#/$defs/datetime" }, "say": { "anyOf": [ { "$ref": "common.schema.json#/$defs/say" }, { "type": "null" } ] } }
    },
    "bv_incident": {
      "type": "object", "additionalProperties": false, "required": ["incident_id", "type", "severity", "status", "title", "summary", "at", "provenance"],
      "properties": {
        "incident_id": { "$ref": "common.schema.json#/$defs/incident_id" }, "type": { "$ref": "event.schema.json#/$defs/incident_type" }, "severity": { "enum": ["info", "warn", "high"] }, "status": { "enum": ["open", "acked", "closed"] },
        "title": { "$ref": "common.schema.json#/$defs/localized" }, "summary": { "$ref": "common.schema.json#/$defs/localized" },
        "verification_id": { "$ref": "common.schema.json#/$defs/verification_id" }, "verification_status": { "$ref": "verification.schema.json#/$defs/status" },
        "claimed_identity": { "type": "string" }, "amount": { "type": ["number", "null"] }, "method": { "$ref": "common.schema.json#/$defs/money_method" },
        "red_flags": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/money_red_flag" } }, "pattern_flag": { "const": "possible_fraud_pattern" },
        "provenance": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["label", "source"], "properties": { "label": { "type": "string" }, "source": { "$ref": "common.schema.json#/$defs/source" } } } },
        "at": { "$ref": "common.schema.json#/$defs/datetime" }
      }
    },
    "bv_dose_slot": {
      "type": "object", "additionalProperties": false, "required": ["slot", "status", "taken_at", "via"],
      "properties": { "slot": { "$ref": "common.schema.json#/$defs/slot" }, "status": { "enum": ["taken", "uncertain", "missed", "due", "upcoming"] }, "taken_at": { "anyOf": [ { "$ref": "common.schema.json#/$defs/datetime" }, { "type": "null" } ] }, "via": { "anyOf": [ { "enum": ["lid_qr", "phone_line", "app"] }, { "type": "null" } ] }, "lid_color": { "$ref": "common.schema.json#/$defs/hex_color" }, "meds": { "type": "array", "items": { "type": "string" }, "description": "Only for views with show_med_names; never sent to elder views." } }
    },
    "bv_dose_day": { "type": "object", "additionalProperties": false, "required": ["date", "slots"], "properties": { "date": { "$ref": "common.schema.json#/$defs/date" }, "slots": { "type": "array", "items": { "$ref": "#/$defs/bv_dose_slot" } } } },
    "bv_dose_week": { "type": "object", "additionalProperties": false, "required": ["days"], "properties": { "days": { "type": "array", "maxItems": 7, "items": { "$ref": "#/$defs/bv_dose_day" } } } },
    "bv_rota_day": { "type": "object", "additionalProperties": false, "required": ["date", "day", "on_duty", "backup"], "properties": { "date": { "$ref": "common.schema.json#/$defs/date" }, "day": { "$ref": "common.schema.json#/$defs/weekday" }, "on_duty": { "$ref": "common.schema.json#/$defs/member_id" }, "backup": { "$ref": "common.schema.json#/$defs/member_id" } } },
    "bv_rota_me": {
      "type": "object", "additionalProperties": false, "required": ["is_my_turn", "date", "on_duty", "backup", "until", "next_shift", "answer"],
      "properties": { "is_my_turn": { "type": "boolean" }, "date": { "$ref": "common.schema.json#/$defs/date" }, "on_duty": { "$ref": "#/$defs/bv_person" }, "backup": { "$ref": "#/$defs/bv_person" }, "until": { "anyOf": [ { "$ref": "common.schema.json#/$defs/hhmm" }, { "type": "null" } ] }, "next_shift": { "anyOf": [ { "$ref": "common.schema.json#/$defs/date" }, { "type": "null" } ] }, "answer": { "$ref": "common.schema.json#/$defs/localized", "description": "e.g. 'Yes. Tonight until 9:30.' / 'No. Ana is on tonight; you're next on Saturday.'" }, "status_line": { "$ref": "common.schema.json#/$defs/localized" } }
    },
    "bv_timeline_item": {
      "type": "object", "additionalProperties": false, "required": ["event_id", "kind", "at", "text", "source", "superseded"],
      "properties": { "event_id": { "$ref": "common.schema.json#/$defs/event_id" }, "kind": { "$ref": "event.schema.json#/$defs/kind" }, "at": { "$ref": "common.schema.json#/$defs/datetime" }, "text": { "$ref": "common.schema.json#/$defs/localized" }, "source": { "$ref": "common.schema.json#/$defs/source" }, "source_label": { "$ref": "common.schema.json#/$defs/localized" }, "rule_id": { "$ref": "common.schema.json#/$defs/rule_id" }, "superseded": { "type": "boolean" } }
    },
    "bv_life_area": {
      "type": "object", "additionalProperties": false, "required": ["id", "label", "status"],
      "properties": { "id": { "$ref": "village_spec.schema.json#/$defs/life_area_id" }, "label": { "type": "string" }, "status": { "$ref": "common.schema.json#/$defs/localized", "description": "Live chip text: '2/2 lids today', '1 scam stopped', 'Marco on duty'." }, "rules": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/rule_id" } }, "trusted_contacts": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/member_id" } } }
    },
    "bv_proposal": {
      "type": "object", "additionalProperties": false, "required": ["proposal_id", "title", "changes", "evidence_labels", "status"],
      "properties": { "proposal_id": { "$ref": "common.schema.json#/$defs/proposal_id" }, "title": { "$ref": "common.schema.json#/$defs/localized" }, "changes": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/localized" } }, "evidence_labels": { "type": "array", "items": { "type": "string" } }, "status": { "$ref": "proposal.schema.json#/$defs/status" }, "release_id": { "$ref": "common.schema.json#/$defs/release_id" } }
    },
    "patch": {
      "type": "object", "additionalProperties": false, "required": ["type", "rev", "base_rev", "role", "ops"],
      "properties": {
        "type": { "const": "patch" },
        "rev": { "$ref": "common.schema.json#/$defs/rev" },
        "base_rev": { "$ref": "common.schema.json#/$defs/rev" },
        "role": { "$ref": "common.schema.json#/$defs/role_key" },
        "ops": { "type": "array", "minItems": 1, "maxItems": 24, "items": { "$ref": "common.schema.json#/$defs/view_patch_op" } },
        "proposal_id": { "$ref": "common.schema.json#/$defs/proposal_id" },
        "highlight": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/element_id" }, "description": "Element ids to flash as NEW." }
      }
    },
    "event": {
      "type": "object", "additionalProperties": false, "required": ["type", "event"],
      "properties": {
        "type": { "const": "event" },
        "event": { "$ref": "event.schema.json" },
        "data": { "$ref": "#/$defs/data", "description": "Binding values that changed because of this row (same keys as snapshot.data)." }
      }
    },
    "prompt": {
      "type": "object", "additionalProperties": false, "required": ["type", "verification_id", "question", "detail", "options", "deadline"],
      "description": "Sent only to the claimed member's sockets (in-app 'Village is calling you' verification). Answer with action answer_verification.",
      "properties": {
        "type": { "const": "prompt" },
        "verification_id": { "$ref": "common.schema.json#/$defs/verification_id" },
        "question": { "$ref": "common.schema.json#/$defs/localized" },
        "detail": { "$ref": "common.schema.json#/$defs/localized" },
        "options": {
          "type": "array", "minItems": 2, "maxItems": 3,
          "items": { "type": "object", "additionalProperties": false, "required": ["id", "label"], "properties": { "id": { "$ref": "common.schema.json#/$defs/verification_answer" }, "label": { "$ref": "common.schema.json#/$defs/localized" } } }
        },
        "deadline": { "$ref": "common.schema.json#/$defs/datetime" },
        "closed": { "type": "boolean", "description": "true = dismiss the prompt (answered elsewhere or deadline)." }
      }
    },
    "result": {
      "type": "object", "additionalProperties": false, "required": ["type", "req_id", "ok"],
      "properties": {
        "type": { "const": "result" },
        "req_id": { "$ref": "#/$defs/req_id" },
        "ok": { "type": "boolean" },
        "decision": { "$ref": "gate.schema.json#/$defs/decision" },
        "event_id": { "$ref": "common.schema.json#/$defs/event_id" },
        "error": { "type": "string", "maxLength": 300 }
      }
    },
    "pong": { "type": "object", "additionalProperties": false, "required": ["type", "ts"], "properties": { "type": { "const": "pong" }, "ts": { "type": "number" } } },
    "chat": {
      "type": "object", "additionalProperties": false, "required": ["type", "village", "message"],
      "description": "1.1.0 (D16). One new village chat row, fanned out to every member socket whose view is not elder, plus control. Clients append it to the chat:village binding (keep the last 50). A member's own POST /villages/{id}/messages is echoed back as a chat frame too (dedupe on message.id).",
      "properties": {
        "type": { "const": "chat" },
        "village": { "$ref": "common.schema.json#/$defs/village_id" },
        "message": { "$ref": "message.schema.json" }
      }
    },
    "error": {
      "type": "object", "additionalProperties": false, "required": ["type", "code", "message"],
      "description": "Sent before the server closes the socket (bad_token, contract_mismatch) or on a bad frame.",
      "properties": { "type": { "const": "error" }, "code": { "enum": ["bad_token", "contract_mismatch", "bad_message", "not_allowed", "rate_limited"] }, "message": { "type": "string", "maxLength": 300 } }
    },

    "control": {
      "type": "object", "additionalProperties": false, "required": ["type", "kind", "payload", "at"],
      "description": "Control Room only (role=control).",
      "properties": {
        "type": { "const": "control" },
        "kind": { "enum": ["reasoning", "build_log", "release", "qa", "gate", "counter", "clock", "proposal", "blueprint"], "description": "1.1.0 added proposal (full Evolve card for the Control Room) and blueprint (typed founding chips; optional, the reasoning stream still carries the text)." },
        "payload": { "type": "object" },
        "at": { "$ref": "common.schema.json#/$defs/datetime" }
      },
      "allOf": [
        { "if": { "properties": { "kind": { "const": "reasoning" } } }, "then": { "properties": { "payload": { "type": "object", "additionalProperties": false, "required": ["source", "kind", "text"], "properties": { "source": { "enum": ["builder", "evolve", "gate", "voice", "release", "memory"] }, "kind": { "enum": ["plan", "decision", "note"], "description": "decision = a row of the DecisionsLog (agent autonomy)." }, "text": { "type": "string", "maxLength": 400 }, "trace_id": { "$ref": "common.schema.json#/$defs/trace_id" }, "village": { "$ref": "common.schema.json#/$defs/village_id" } } } } } },
        { "if": { "properties": { "kind": { "const": "build_log" } } }, "then": { "properties": { "payload": { "type": "object", "additionalProperties": false, "required": ["release_id", "rev", "stage", "line", "level"], "properties": { "release_id": { "$ref": "common.schema.json#/$defs/release_id" }, "rev": { "$ref": "common.schema.json#/$defs/rev" }, "stage": { "$ref": "release.schema.json#/$defs/stage_name" }, "line": { "type": "string", "maxLength": 500 }, "level": { "enum": ["info", "warn", "error"] } } } } } },
        { "if": { "properties": { "kind": { "const": "release" } } }, "then": { "properties": { "payload": { "type": "object", "additionalProperties": false, "required": ["receipt"], "properties": { "receipt": { "$ref": "release.schema.json" } } } } } },
        { "if": { "properties": { "kind": { "const": "qa" } } }, "then": { "properties": { "payload": { "type": "object", "additionalProperties": false, "required": ["release_id", "rev", "stage", "status"], "properties": { "release_id": { "$ref": "common.schema.json#/$defs/release_id" }, "rev": { "$ref": "common.schema.json#/$defs/rev" }, "stage": { "enum": ["tests", "anchor_qa", "arize_evals"] }, "status": { "$ref": "release.schema.json#/$defs/stage_status" }, "summary": { "type": "string", "maxLength": 200 }, "evidence_url": { "$ref": "common.schema.json#/$defs/url" }, "live_view_url": { "$ref": "common.schema.json#/$defs/url" } } } } } },
