{
  "lang": "en",
  "theme": "dashboard",
  "root": "s",
  "elements": {
    "s": {
      "type": "Screen",
      "props": {
        "title": "Mamá today",
        "subtitle": "Reyes family"
      },
      "children": [
        "al",
        "areas",
        "inc",
        "vp",
        "dose",
        "org",
        "rota",
        "tl",
        "chat"
      ]
    },
    "al": {
      "type": "Alert",
      "props": {
        "source": "policy",
        "bind": "alerts:active",
        "severity_levels": [
          "danger",
          "warn"
        ],
        "dismissible": false,
        "empty_text": "No alerts right now",
        "show_escalation_status": true,
        "show_countdown": true
      }
    },
    "areas": {
      "type": "LifeAreas",
      "props": {
        "title": "Mamá's village",
        "bind": "blueprint:life_areas",
        "areas": [
          "health",
          "money",
          "people"
        ],
        "show_rules": true,
        "show_contacts": true
      }
    },
    "inc": {
      "type": "IncidentCard",
      "props": {
        "title": "Needs your attention",
        "bind": "incidents:open",
        "subject": "m_carmen",
        "show_red_flags": true,
        "show_verification": true,
        "show_provenance": true,
        "allow_ack": true,
        "limit": 3
      }
    },
    "vp": {
      "type": "VerificationPrompt",
      "props": {
        "bind": "verifications:pending?member=me",
        "question_template": "Did you just call {care_recipient} asking for {amount}{method}?",
        "yes_label": "Yes, it was me",
        "no_label": "That wasn't me",
        "show_countdown": true
      }
    },
    "dose": {
      "type": "DoseTracker",
      "props": {
        "title": "Mamá's pills today",
        "subject": "m_carmen",
        "slots": [
          "morning",
          "evening"
        ],
        "bind": "facts:dose_event?subject=m_carmen&valid_at=today",
        "show_med_names": true,
        "allow_log": true,
        "big": false
      }
    },
    "org": {
      "type": "PillOrganizer",
      "props": {
        "title": "Her pill organizer",
        "subject": "m_carmen",
        "slots": [
          "morning",
          "evening"
        ],
        "lid_colors": [
          "#E8B12F",
          "#2F5FA7"
        ],
        "labels": [
          "Morning",
          "Evening"
        ],
        "bind": "facts:dose_event?subject=m_carmen&valid_at=week",
        "days": [
          "Mon",
          "Tue",
          "Wed",
          "Thu",
          "Fri",
          "Sat",
          "Sun"
        ],
        "show_today_only": false
      }
    },
    "rota": {
      "type": "CareRota",
      "props": {
        "title": "Who's on this week",
        "bind": "rota:week",
        "period": "week",
        "highlight_current_user": true,
        "allow_swap": true,
        "show_backup": true
      }
    },
    "tl": {
      "type": "Timeline",
      "props": {
        "title": "What happened",
        "bind": "timeline:subject=m_carmen",
        "subject": "m_carmen",
        "event_kinds": [
          "dose",
          "dose_repeat_scan",
          "dose_repeat",
          "reminder",
          "escalation",
          "ack",
          "symptom",
          "shift",
          "med_change",
          "money_request",
          "verification",
          "incident"
        ],
        "show_superseded": true,
        "show_provenance": true,
        "limit": 20
      }
    },
    "chat": {
      "type": "VillageChat",
      "props": {
        "bind": "chat:village",
        "composer": true,
        "title": "Village chat",
        "mention_label": "@Village",
        "allow_approve": true,
        "limit": 50
      }
    }
  },
  "needs_served": {
    "al": [
      "n_safety",
      "n_evening_pills"
    ],
    "areas": [
      "n_evening_pills",
      "n_scam_calls",
      "n_turns"
    ],
    "inc": [
      "n_scam_calls"
    ],
    "vp": [
      "n_scam_calls"
    ],
    "dose": [
      "n_evening_pills"
    ],
    "org": [
      "n_evening_pills"
    ],
    "rota": [
      "n_turns"
    ],
    "tl": [
      "n_dose_change",
      "n_evening_pills",
      "n_scam_calls"
    ],
    "chat": [
      "n_safety"
    ]
  }
}